{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vrac",
  "version": "0.0.0",
  "identifier": "com.sillovv.vrac",
  "build": {
    "frontendDist": ".."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "vrac",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8787 http://localhost:8787; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
